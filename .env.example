# Real .env is gitignored — copy this file to .env and fill in your values.

# Your FPL team ID — found in the URL when viewing your team on the official site:
# https://fantasy.premierleague.com/entry/<FPL_TEAM_ID>/event/<gameweek>
FPL_TEAM_ID=

# Optional: target mini-league ID for risk auto-infer (post-v1, PRD §6a.2). Leave blank for now.
FPL_TARGET_LEAGUE_ID=

# Local account this CLI run acts as (M8 multi-tenancy) — created by
# scripts/migrate_to_multitenant.py. Only used by the CLI; the web app resolves the
# account from a JWT instead (api/deps.py).
FPL_ADMIN_EMAIL=

# Web app only (api/, not the CLI). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Web app only. Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:3000

# Web app only. Comma-separated list of account emails allowed to call POST /train — it
# retrains and can overwrite the single shared model artifact every tenant's
# /recommendations and /plans load, so it's gated to operators, not every registered user.
ADMIN_EMAILS=

# Deploy only (docker-compose.yml's caddy service, GCP VM). The domain Caddy requests a
# TLS cert for — its DNS A record must already point at the VM's static IP.
DOMAIN=
